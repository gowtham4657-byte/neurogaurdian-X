# Copy this file to .env on your server. Do not commit real secrets.

# Optional app-to-backend token. The Flutter app stores only this device token.
NGX_DEVICE_TOKEN=change-this-random-device-token

# Google Places key stays on backend for production hospital lookup.
GOOGLE_MAPS_API_KEY=
# GOOGLE_PLACES_API_KEY= can also be used instead of GOOGLE_MAPS_API_KEY.

# SuperSend key must stay server-side.
SUPERSEND_API_KEY=
SUPERSEND_BASE_URL=https://api.supersend.io/v2

# Set these to your actual SuperSend WhatsApp/push endpoints or proxy routes.
# Leave empty for dry-run testing.
SUPERSEND_WHATSAPP_ENDPOINT=
SUPERSEND_PUSH_ENDPOINT=

# Automatic WhatsApp provider. Use "cloud" for official Meta WhatsApp Cloud
# API or "twilio" for Twilio WhatsApp.
WHATSAPP_PROVIDER=cloud

# Official Meta WhatsApp Cloud API.
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_WABA_ID=
WHATSAPP_CLOUD_TEMPLATE_NAME=neuroguardian_emergency_alert
WHATSAPP_CLOUD_TEMPLATE_LANGUAGE=en_US
# Set true only for testing inside a valid 24-hour WhatsApp customer-service window.
WHATSAPP_CLOUD_ALLOW_TEXT=false

# Twilio WhatsApp alternative.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_CONTENT_SID=

# Immediate push fallback: install the ntfy app on the guardian phone and
# subscribe to this topic. Treat the topic like a password.
NTFY_BASE_URL=https://ntfy.sh
NGX_NTFY_TOPIC=
